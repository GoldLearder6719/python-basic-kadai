      "source": [
        "#リストの中身\n",
        "array = [\"水\",\"金\",\"地\",\"火\",\"木\",\"土\",\"天\",\"海\",\"冥\"]\n",
        "\n",
        "#forループで水〜冥の９行を表示する。\n",
        "for i in array:\n",
        "  print(i)\n",
        "\n",
        "#whileループで水〜冥の９行を表示する。\n",
        "sum = 0\n",
        "\n",
        "while sum < 9:\n",
        "  print(array[sum])\n",
        "  sum = sum + 1\n",
        "  if sum == 9:\n",
        "    break"
      ]
