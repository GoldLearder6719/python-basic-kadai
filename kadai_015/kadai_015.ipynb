      "source": [
        "class Human:\n",
        "    def __init__(self, name, age):\n",
        "        self.name = name\n",
        "        self.age = age\n",
        "\n",
        "    # 情報を出力するメソッド\n",
        "    def printinfo(self):\n",
        "        print(self.name)\n",
        "        print(self.age)\n",
        "\n",
        "\n",
        "# インスタンスを作成（変数に代入）\n",
        "person = Human(\"太郎\", 25)\n",
        "\n",
        "# メソッドを実行\n",
        "person.printinfo()"
      ]
    }
  ]
