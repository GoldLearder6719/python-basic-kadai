        "#関数の定義\n",
        "def calculate_total(price, tax_rate):\n",
        "    total = price + (price * tax_rate / 100)\n",
        "    return total\n",
        "\n",
        "#消費税の計算と結果の出力\n",
        "result = calculate_total(110, 10)\n",
        "print(result)"
